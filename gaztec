#!/usr/bin/env bash
set -euo pipefail

source "$(dirname -- "${BASH_SOURCE[0]}")/gaztec-install"

# exec so that signals (Ctrl-C, SIGTERM) reach aztec/nargo directly instead of killing this
# shell and orphaning them
# if the subcommand is "nargo", run nargo instead
if [[ "${1:-}" == "nargo" ]]; then
  shift
  exec $NARGO "$@"
else
  exec $AZTEC "$@"
fi
